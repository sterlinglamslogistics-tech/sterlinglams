@model SterlingLams.Web.Areas.Admin.ViewModels.AdminProductEditViewModel
@{
    var isNew = Model.Id == 0;
}

<div class="flex items-center gap-3 mb-6">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
       class="text-xs text-neutral-400 hover:text-neutral-700 transition-colors">← Products</a>
    <span class="text-neutral-200">/</span>
    <span class="text-xs text-neutral-600">@(isNew ? "New Product" : Model.Name)</span>
</div>

<div class="max-w-2xl">
    <form asp-area="Admin" asp-controller="Products" asp-action="Save" method="post" enctype="multipart/form-data" class="space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-sm text-red-600 bg-red-50 border border-red-100 rounded-sm px-4 py-3 empty:hidden"></div>

        <div class="bg-white rounded-sm border border-neutral-100 p-6 space-y-4">

            <!-- Name -->
            <div>
                <label asp-for="Name" class="block text-xs text-neutral-500 mb-1">Name <span class="text-red-400">*</span></label>
                <input asp-for="Name" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
                <span asp-validation-for="Name" class="text-xs text-red-500"></span>
            </div>

            <!-- Slug -->
            <div>
                <label asp-for="Slug" class="block text-xs text-neutral-500 mb-1">Slug (auto-generated if blank)</label>
                <input asp-for="Slug" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm font-mono focus:outline-none focus:border-neutral-400" />
            </div>

            <!-- Price + Category -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Price" class="block text-xs text-neutral-500 mb-1">Price (₦) <span class="text-red-400">*</span></label>
                    <input asp-for="Price" type="number" step="0.01"
                           class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
                    <span asp-validation-for="Price" class="text-xs text-red-500"></span>
                </div>
                <div>
                    <label asp-for="CategoryId" class="block text-xs text-neutral-500 mb-1">Category</label>
                    <select asp-for="CategoryId"
                            asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"
                            class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400">
                        <option value="">— Select —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-xs text-red-500"></span>
                </div>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs text-neutral-500 mb-1">Description</label>
                <textarea asp-for="Description" rows="4"
                          class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400"></textarea>
            </div>

            <!-- Material attributes -->
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label asp-for="Material" class="block text-xs text-neutral-500 mb-1">Material</label>
                    <input asp-for="Material" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
                </div>
                <div>
                    <label asp-for="Carat" class="block text-xs text-neutral-500 mb-1">Carat</label>
                    <input asp-for="Carat" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
                </div>
                <div>
                    <label asp-for="GemstoneType" class="block text-xs text-neutral-500 mb-1">Gemstone</label>
                    <input asp-for="GemstoneType" class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
                </div>
            </div>

            <!-- Odoo ID -->
            <div>
                <label asp-for="OdooProductId" class="block text-xs text-neutral-500 mb-1">Odoo Product ID <span class="text-neutral-400">(optional)</span></label>
                <input asp-for="OdooProductId" type="number"
                       class="w-full border border-neutral-200 rounded-sm px-3 py-2 text-sm font-mono focus:outline-none focus:border-neutral-400" />
                <span asp-validation-for="OdooProductId" class="text-xs text-red-500"></span>
            </div>

            <!-- Flags -->
            <div class="flex gap-6">
                <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="rounded" />
                    Active
                </label>
                <label class="flex items-center gap-2 text-sm text-neutral-600 cursor-pointer">
                    <input asp-for="IsFeatured" type="checkbox" class="rounded" />
                    Featured
                </label>
            </div>

            <!-- Image upload -->
            <div>
                <label class="block text-xs text-neutral-500 mb-1">Product Image</label>
                @if (Model.ExistingImages.Any())
                {
                    <div class="flex gap-2 flex-wrap mb-3">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="relative">
                                <img src="@img.Url" alt="@img.AltText" class="w-20 h-20 object-cover border border-neutral-200" />
                                @if (img.IsPrimary)
                                {
                                    <span class="absolute bottom-0 left-0 right-0 text-center text-[10px] bg-neutral-900 text-white py-0.5">Primary</span>
                                }
                            </div>
                        }
                    </div>
                }
                <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                       class="block w-full text-sm text-neutral-500 file:mr-3 file:py-1.5 file:px-3 file:border file:border-neutral-200 file:text-xs file:bg-white file:text-neutral-700 hover:file:bg-neutral-50" />
                <p class="text-xs text-neutral-400 mt-1">JPG, PNG or WEBP · max 5 MB</p>
                <span asp-validation-for="ImageFile" class="text-xs text-red-500"></span>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit"
                    class="px-6 py-2.5 bg-neutral-900 text-white text-sm rounded-sm hover:bg-neutral-700 transition-colors">
                @(isNew ? "Create Product" : "Save Changes")
            </button>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
               class="px-6 py-2.5 border border-neutral-200 text-neutral-600 text-sm rounded-sm hover:bg-neutral-50 transition-colors">
                Cancel
            </a>
        </div>
    </form>
</div>
