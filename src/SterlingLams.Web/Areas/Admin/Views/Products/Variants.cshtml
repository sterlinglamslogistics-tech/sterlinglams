@model SterlingLams.Web.Areas.Admin.ViewModels.AdminProductVariantsViewModel
@{
    ViewData["Title"] = "Variants";
}

<div class="flex items-center gap-3 mb-6">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
       class="text-xs text-neutral-400 hover:text-neutral-700 transition-colors">← Products</a>
    <span class="text-neutral-200">/</span>
    <a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId"
       class="text-xs text-neutral-400 hover:text-neutral-700 transition-colors">@Model.ProductName</a>
    <span class="text-neutral-200">/</span>
    <span class="text-xs text-neutral-600">Variants</span>
</div>

<p class="text-xs text-neutral-400 mb-6">Base price: <span class="font-medium text-neutral-600">₦@Model.BasePrice.ToString("N0")</span> · Variant price = base + adjustment.</p>

<!-- Generate variants -->
<div class="bg-white rounded-sm border border-neutral-100 p-5 mb-8">
    <h2 class="text-sm font-medium text-neutral-800 mb-1">Generate variants</h2>
    <p class="text-xs text-neutral-400 mb-4">Tick the values this product comes in. Every combination becomes a variant (existing ones are kept).</p>

    @if (!Model.Attributes.Any())
    {
        <p class="text-xs text-neutral-400">No attributes defined yet — add them under <a asp-area="Admin" asp-controller="Attributes" asp-action="Index" class="text-brand hover:underline">Attributes</a>.</p>
    }
    else
    {
        <form asp-area="Admin" asp-controller="Products" asp-action="GenerateVariants" asp-route-id="@Model.ProductId" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            @{ var ai = 0; }
            @foreach (var attr in Model.Attributes)
            {
                var big = attr.Values.Count > 12;          // searchable + collapsed for long lists
                var selCount = attr.Values.Count(v => Model.SelectedValueIds.Contains(v.Id));
                ai++;
                <div class="border border-neutral-100 rounded-sm" data-picker>
                    <button type="button" data-toggle
                            class="w-full flex items-center justify-between px-3 py-2 text-left hover:bg-neutral-50 transition-colors">
                        <span class="text-xs font-medium text-neutral-600">
                            @attr.Name
                            <span class="ml-2 text-[10px] text-neutral-400" data-count>@(selCount > 0 ? $"{selCount} selected" : "")</span>
                        </span>
                        <span class="text-neutral-300 text-[10px]" data-caret>@(big ? "▾" : "")</span>
                    </button>

                    <!-- chips of currently-selected values (visible even when collapsed) -->
                    <div class="px-3 pb-2 flex flex-wrap gap-1.5 @(selCount == 0 ? "hidden" : "")" data-chips></div>

                    <!-- option list (collapsed by default for long lists) -->
                    <div class="px-3 pb-3 @(big ? "hidden" : "")" data-body>
                        @if (big)
                        {
                            <input type="text" placeholder="Search @attr.Name…" data-search
                                   class="w-full mb-2 border border-neutral-200 rounded-sm px-2 py-1 text-xs focus:outline-none focus:border-brand" />
                        }
                        <div class="flex flex-wrap gap-2" data-options>
                            @foreach (var v in attr.Values.OrderBy(v => v.DisplayOrder).ThenBy(v => v.Value))
                            {
                                <label data-opt data-label="@v.Value.ToLowerInvariant()"
                                       class="inline-flex items-center gap-1.5 border border-neutral-200 rounded-sm px-3 py-1.5 text-xs cursor-pointer hover:border-neutral-400 has-[:checked]:border-brand has-[:checked]:bg-brand-soft">
                                    <input type="checkbox" name="valueIds" value="@v.Id" class="accent-brand" data-val="@v.Value"
                                           @(Model.SelectedValueIds.Contains(v.Id) ? "checked" : "") />
                                    @v.Value
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
            <button type="submit" class="px-4 py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-brand transition-colors">
                Generate Variants
            </button>
        </form>

        <script>
        (function () {
            document.querySelectorAll('[data-picker]').forEach(function (picker) {
                var body   = picker.querySelector('[data-body]');
                var chips  = picker.querySelector('[data-chips]');
                var count  = picker.querySelector('[data-count]');
                var search = picker.querySelector('[data-search]');
                var toggle = picker.querySelector('[data-toggle]');
                var opts   = Array.prototype.slice.call(picker.querySelectorAll('[data-opt]'));

                function refresh() {
                    var checked = opts.map(function (o) { return o.querySelector('input'); })
                                      .filter(function (i) { return i.checked; });
                    count.textContent = checked.length ? checked.length + ' selected' : '';
                    chips.innerHTML = '';
                    chips.classList.toggle('hidden', checked.length === 0);
                    checked.forEach(function (input) {
                        var chip = document.createElement('span');
                        chip.className = 'inline-flex items-center gap-1 bg-brand-soft text-brand border border-neutral-200 rounded-sm px-2 py-0.5 text-[11px]';
                        var btn = document.createElement('button');
                        btn.type = 'button';
                        btn.textContent = '✕';
                        btn.className = 'hover:text-rose-600';
                        btn.addEventListener('click', function () { input.checked = false; refresh(); });
                        chip.appendChild(document.createTextNode(input.dataset.val + ' '));
                        chip.appendChild(btn);
                        chips.appendChild(chip);
                    });
                }

                toggle.addEventListener('click', function () { if (body) body.classList.toggle('hidden'); });
                opts.forEach(function (o) { o.querySelector('input').addEventListener('change', refresh); });
                if (search) {
                    search.addEventListener('input', function () {
                        var q = search.value.toLowerCase();
                        opts.forEach(function (o) {
                            o.classList.toggle('hidden', q && o.dataset.label.indexOf(q) === -1);
                        });
                    });
                }
                refresh();
            });
        })();
        </script>
    }
</div>

<!-- Existing variants -->
<div class="bg-white rounded-sm border border-neutral-100 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-neutral-50 border-b border-neutral-100">
                <th class="text-left px-4 py-2 text-xs text-neutral-400 font-medium">Variant</th>
                <th class="text-left px-4 py-2 text-xs text-neutral-400 font-medium">SKU</th>
                <th class="text-right px-4 py-2 text-xs text-neutral-400 font-medium">Price adj (₦)</th>
                <th class="text-right px-4 py-2 text-xs text-neutral-400 font-medium">Stock</th>
                <th class="text-center px-4 py-2 text-xs text-neutral-400 font-medium">Active</th>
                <th class="text-center px-4 py-2 text-xs text-neutral-400 font-medium">Odoo</th>
                <th class="text-right px-4 py-2 text-xs text-neutral-400 font-medium">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-neutral-50">
            @if (!Model.Variants.Any())
            {
                <tr><td colspan="7" class="px-4 py-8 text-center text-xs text-neutral-400">No variants yet. Generate some above.</td></tr>
            }
            @foreach (var v in Model.Variants)
            {
                var fid = $"sv-{v.Id}";
                <tr>
                    <td class="px-4 py-2 text-xs font-medium text-neutral-800">@v.Name</td>
                    <td class="px-4 py-2">
                        <input type="text" name="sku" value="@v.Sku" placeholder="—" form="@fid"
                               class="w-28 border border-neutral-200 rounded-sm px-2 py-1 text-xs font-mono focus:outline-none focus:border-brand" />
                    </td>
                    <td class="px-4 py-2 text-right">
                        <input type="number" step="0.01" name="priceAdjustment" value="@v.PriceAdjustment" form="@fid"
                               class="w-24 border border-neutral-200 rounded-sm px-2 py-1 text-xs text-right focus:outline-none focus:border-brand" />
                    </td>
                    <td class="px-4 py-2 text-right text-xs text-neutral-600">@v.Stock</td>
                    <td class="px-4 py-2 text-center">
                        <input type="checkbox" name="isActive" value="true" form="@fid" class="accent-brand" @(v.IsActive ? "checked" : "") />
                    </td>
                    <td class="px-4 py-2 text-center text-[10px] font-mono text-neutral-400">@(v.OdooVariantId == 0 ? "—" : v.OdooVariantId.ToString())</td>
                    <td class="px-4 py-2 text-right whitespace-nowrap">
                        <form id="@fid" asp-area="Admin" asp-controller="Products" asp-action="SaveVariant" asp-route-id="@Model.ProductId" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="variantId" value="@v.Id" />
                            <button type="submit" class="text-xs text-neutral-600 hover:text-neutral-900">Save</button>
                        </form>
                        <form asp-area="Admin" asp-controller="Products" asp-action="DeleteVariant" asp-route-id="@Model.ProductId" method="post" class="inline"
                              onsubmit="return confirm('Delete variant @v.Name?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="variantId" value="@v.Id" />
                            <button type="submit" class="text-xs text-rose-400 hover:text-rose-700 ml-2">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
