@model SterlingLams.Web.Areas.Admin.ViewModels.AdminInventoryViewModel
@{
    ViewData["Title"] = "Inventory";
}

<!-- Header with sync -->
<div class="flex items-center justify-between mb-6">
    <div>
        @if (Model.LastSyncedAt.HasValue)
        {
            <p class="text-xs text-neutral-400">Last synced: @Model.LastSyncedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
        }
    </div>
    <form asp-area="Admin" asp-controller="Inventory" asp-action="Sync" method="post">
        @Html.AntiForgeryToken()
        <button type="submit"
                class="px-4 py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700 transition-colors">
            ↺ Sync from Odoo
        </button>
    </form>
</div>

<!-- Store filter + search -->
<form method="get" class="flex flex-col sm:flex-row gap-3 mb-4">
    <div class="flex gap-1 flex-wrap">
        @foreach (var s in Model.Stores)
        {
            var active = Model.SelectedStoreId == s.Id;
            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" asp-route-storeId="@s.Id" asp-route-q="@Model.SearchQuery"
               class="px-3 py-1.5 text-xs rounded-sm transition-colors @(active ? "bg-neutral-900 text-white" : "bg-white text-neutral-600 border border-neutral-200 hover:border-neutral-400")">
                @s.Name
            </a>
        }
    </div>
    <div class="flex gap-2 flex-1">
        <input type="hidden" name="storeId" value="@Model.SelectedStoreId" />
        <input type="text" name="q" value="@Model.SearchQuery" placeholder="Search product or SKU…"
               class="flex-1 border border-neutral-200 rounded-sm px-3 py-2 text-sm focus:outline-none focus:border-neutral-400" />
        <button type="submit" class="px-4 py-2 bg-neutral-900 text-white text-xs rounded-sm hover:bg-neutral-700 transition-colors">Search</button>
    </div>
</form>

<div class="bg-white rounded-sm border border-neutral-100 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-neutral-50 border-b border-neutral-100">
                <th class="text-left px-6 py-2 text-xs text-neutral-400 font-medium">Product</th>
                <th class="text-left px-6 py-2 text-xs text-neutral-400 font-medium">SKU</th>
                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">On Hand</th>
                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Reserved</th>
                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Available</th>
                <th class="text-right px-6 py-2 text-xs text-neutral-400 font-medium">Alert</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-neutral-50">
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="6" class="px-6 py-12 text-center text-xs text-neutral-400">No inventory records. Click "Sync from Odoo" to pull stock levels.</td></tr>
            }
            @foreach (var row in Model.Rows)
            {
                <tr class="hover:bg-neutral-50 transition-colors @(row.IsLowStock ? "bg-amber-50/40" : "")">
                    <td class="px-6 py-2.5 text-xs font-medium text-neutral-800">@row.ProductName</td>
                    <td class="px-6 py-2.5 text-xs font-mono text-neutral-400">@(string.IsNullOrEmpty(row.Sku) ? "—" : row.Sku)</td>
                    <td class="px-6 py-2.5 text-xs text-right text-neutral-600">@row.QuantityOnHand</td>
                    <td class="px-6 py-2.5 text-xs text-right text-neutral-400">@row.QuantityReserved</td>
                    <td class="px-6 py-2.5 text-xs text-right font-medium @(row.Available == 0 ? "text-red-600" : row.IsLowStock ? "text-amber-600" : "text-neutral-800")">@row.Available</td>
                    <td class="px-6 py-2.5 text-right">
                        @if (row.Available == 0)
                        {
                            <span class="text-[10px] bg-red-50 text-red-700 px-2 py-0.5 rounded-full">Out of stock</span>
                        }
                        else if (row.IsLowStock)
                        {
                            <span class="text-[10px] bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full">Low stock</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", new SterlingLams.Web.Areas.Admin.ViewModels.PagerModel(
    Model.CurrentPage, Model.TotalPages, "Index", "Inventory",
    new() { ["storeId"] = Model.SelectedStoreId?.ToString() ?? "", ["q"] = Model.SearchQuery }))
