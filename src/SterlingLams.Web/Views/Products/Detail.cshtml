@model SterlingLams.Web.Models.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["Description"] = Model.ShortDescription;
    Layout = "_Layout";

    var variantsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Variants.Select(v => new
        {
            id = v.Id,
            price = v.Price,
            formattedPrice = v.FormattedPrice,
            available = v.Available,
            values = v.ValueMap
        }));
}

<div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="text-xs text-neutral-400 tracking-wider mb-10 flex gap-2 items-center">
        <a asp-controller="Home" asp-action="Index" class="hover:text-neutral-700 transition-colors">Home</a>
        <span>/</span>
        <a asp-controller="Products" asp-action="Index" asp-route-category="@Model.CategorySlug" class="hover:text-neutral-700 transition-colors">@Model.CategoryName</a>
        <span>/</span>
        <span class="text-neutral-700">@Model.Name</span>
    </nav>

    <div class="grid md:grid-cols-2 gap-16 lg:gap-24">

        <!-- ─── Image Gallery ─────────────────────────────────────────── -->
        <div class="space-y-3">
            <div class="aspect-square bg-neutral-50 overflow-hidden">
                <img id="main-image" src="@Model.PrimaryImageUrl" alt="@Model.Name"
                     class="w-full h-full object-cover object-center" />
            </div>
            @if (Model.ImageUrls.Count > 1)
            {
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var (url, i) in Model.ImageUrls.Select((u, i) => (u, i)))
                    {
                        <button onclick="document.getElementById('main-image').src = '@url'"
                                class="aspect-square bg-neutral-50 overflow-hidden border-2 @(i == 0 ? "border-neutral-900" : "border-transparent") hover:border-neutral-400 transition-colors">
                            <img src="@url" alt="@Model.Name view @(i+1)" class="w-full h-full object-cover" />
                        </button>
                    }
                </div>
            }
        </div>

        <!-- ─── Product Info ──────────────────────────────────────────── -->
        <div class="flex flex-col">
            @Html.AntiForgeryToken()
            <p class="text-xs tracking-[0.3em] uppercase text-brand mb-2">@Model.CategoryName</p>
            <h1 class="font-cormorant text-4xl font-light text-neutral-900 mb-4">@Model.Name</h1>
            <p id="product-price" class="text-2xl font-light text-neutral-800 mb-8">@Model.FormattedPrice</p>

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="text-sm text-neutral-500 leading-relaxed mb-8 font-light">@Model.ShortDescription</p>
            }

            <!-- ─── Store Stock ────────────────────────────────────────── -->
            @if (Model.StoreStock.Any())
            {
                <div class="mb-8">
                    <p class="text-xs tracking-[0.2em] uppercase text-neutral-500 mb-4">Availability</p>
                    <div class="space-y-2">
                        @foreach (var store in Model.StoreStock)
                        {
                            <div class="flex items-center justify-between py-2.5 border-b border-neutral-100">
                                <span class="text-sm text-neutral-700">@store.StoreName</span>
                                @if (store.IsAvailable)
                                {
                                    <span class="text-xs text-emerald-700 tracking-wider">
                                        @store.Quantity in stock
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-neutral-400 tracking-wider">Out of stock</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ─── Variant selectors ─────────────────────────────────── -->
            @if (Model.HasVariants)
            {
                <div id="variant-options" class="mb-6 space-y-5">
                    @foreach (var attr in Model.AttributeOptions)
                    {
                        <div data-attribute="@attr.Name">
                            <p class="text-xs tracking-[0.2em] uppercase text-neutral-500 mb-3">@attr.Name</p>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var val in attr.Values)
                                {
                                    <button type="button"
                                            class="variant-opt border border-neutral-300 text-xs px-4 py-2 transition-colors hover:border-neutral-900 hover:text-neutral-900"
                                            data-attr="@attr.Name" data-value="@val">
                                        @val
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <p id="variant-status" class="text-xs tracking-wider text-neutral-400 mb-8">Select options to see availability</p>
            }

            <!-- ─── Actions ───────────────────────────────────────────── -->
            <div class="flex gap-3 mb-8">
                @{
                    var addDisabled = Model.HasVariants || !Model.IsAvailableAnywhere;
                    var addLabel = Model.HasVariants ? "Select Options"
                        : (Model.IsAvailableAnywhere ? "Add to Bag" : "Out of Stock");
                }
                <button id="add-to-cart"
                        data-product-id="@Model.Id"
                        data-has-variants="@(Model.HasVariants ? "true" : "false")"
                        @(addDisabled ? "disabled" : "")
                        class="flex-1 bg-neutral-900 text-white text-xs tracking-[0.2em] uppercase py-4 px-8 hover:bg-brand transition-colors duration-300 disabled:opacity-40 disabled:cursor-not-allowed">
                    @addLabel
                </button>
                <button id="wishlist-btn"
                        data-product-id="@Model.Id"
                        aria-label="@(Model.IsInWishlist ? "Remove from wishlist" : "Add to wishlist")"
                        class="border border-neutral-300 px-4 hover:border-neutral-900 transition-colors">
                    <svg class="w-5 h-5 @(Model.IsInWishlist ? "fill-neutral-900" : "")"
                         fill="@(Model.IsInWishlist ? "currentColor" : "none")"
                         stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </button>
            </div>

            <!-- Reserve for pickup -->
            <a asp-controller="Checkout" asp-action="Index"
               class="text-center text-xs tracking-[0.2em] uppercase border border-neutral-300 py-4 hover:border-neutral-900 transition-colors mb-8 block">
                Reserve for Store Pickup
            </a>

            <!-- ─── Specifications ─────────────────────────────────────── -->
            @if (!string.IsNullOrEmpty(Model.Metal) || !string.IsNullOrEmpty(Model.GemstoneType) || !string.IsNullOrEmpty(Model.Carat))
            {
                <div class="border-t border-neutral-100 pt-8">
                    <p class="text-xs tracking-[0.2em] uppercase text-neutral-500 mb-4">Details</p>
                    <dl class="space-y-2">
                        @if (!string.IsNullOrEmpty(Model.Metal))
                        {
                            <div class="flex justify-between text-sm">
                                <dt class="text-neutral-500 font-light">Metal</dt>
                                <dd class="text-neutral-800">@Model.Metal</dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.GemstoneType))
                        {
                            <div class="flex justify-between text-sm">
                                <dt class="text-neutral-500 font-light">Gemstone</dt>
                                <dd class="text-neutral-800">@Model.GemstoneType</dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Carat))
                        {
                            <div class="flex justify-between text-sm">
                                <dt class="text-neutral-500 font-light">Carat</dt>
                                <dd class="text-neutral-800">@Model.Carat</dd>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Weight))
                        {
                            <div class="flex justify-between text-sm">
                                <dt class="text-neutral-500 font-light">Weight</dt>
                                <dd class="text-neutral-800">@Model.Weight</dd>
                            </div>
                        }
                    </dl>
                </div>
            }
        </div>
    </div>

    <!-- ─── Related Products ──────────────────────────────────────────────── -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="mt-24">
            <div class="text-center mb-12">
                <p class="text-xs tracking-[0.3em] uppercase text-brand mb-3">You may also like</p>
                <h2 class="font-cormorant text-3xl font-light">Related Pieces</h2>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                @foreach (var p in Model.RelatedProducts)
                {
                    <a asp-controller="Products" asp-action="Detail" asp-route-slug="@p.Slug" class="group">
                        <div class="aspect-square bg-neutral-50 mb-3 overflow-hidden">
                            <img src="@p.PrimaryImageUrl" alt="@p.Name"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        </div>
                        <h3 class="text-sm font-light text-neutral-700 group-hover:text-neutral-900 transition-colors">@p.Name</h3>
                        <p class="text-xs text-neutral-400 mt-1">@p.FormattedPrice</p>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    const variants = @Html.Raw(variantsJson);
    const addBtn = document.getElementById('add-to-cart');
    const hasVariants = addBtn?.dataset.hasVariants === 'true';
    const priceEl = document.getElementById('product-price');
    const statusEl = document.getElementById('variant-status');
    const basePriceLabel = priceEl ? priceEl.textContent : '';

    let selectedVariantId = null;
    const selected = {};   // attribute name -> chosen value

    // Which attributes must be chosen (one selector group per attribute)
    const attrGroups = Array.from(document.querySelectorAll('#variant-options [data-attribute]'))
        .map(g => g.dataset.attribute);

    function findVariant() {
        return variants.find(v =>
            attrGroups.every(a => v.values[a] === selected[a]));
    }

    function refresh() {
        if (!hasVariants) return;
        const allChosen = attrGroups.every(a => selected[a]);
        if (!allChosen) {
            selectedVariantId = null;
            addBtn.disabled = true;
            addBtn.textContent = 'Select Options';
            if (statusEl) { statusEl.textContent = 'Select options to see availability'; statusEl.className = 'text-xs tracking-wider text-neutral-400 mb-8'; }
            return;
        }
        const v = findVariant();
        if (!v) {
            selectedVariantId = null;
            addBtn.disabled = true;
            addBtn.textContent = 'Unavailable';
            if (statusEl) { statusEl.textContent = 'This combination is not available'; statusEl.className = 'text-xs tracking-wider text-neutral-400 mb-8'; }
            return;
        }
        selectedVariantId = v.id;
        if (priceEl) priceEl.textContent = v.formattedPrice;
        if (v.available > 0) {
            addBtn.disabled = false;
            addBtn.textContent = 'Add to Bag';
            if (statusEl) { statusEl.textContent = v.available + ' in stock'; statusEl.className = 'text-xs tracking-wider text-emerald-700 mb-8'; }
        } else {
            addBtn.disabled = true;
            addBtn.textContent = 'Out of Stock';
            if (statusEl) { statusEl.textContent = 'Out of stock'; statusEl.className = 'text-xs tracking-wider text-neutral-400 mb-8'; }
        }
    }

    // Attribute option buttons
    document.querySelectorAll('.variant-opt').forEach(btn => {
        btn.addEventListener('click', () => {
            const attr = btn.dataset.attr;
            // Toggle selection within this attribute group
            document.querySelectorAll(`.variant-opt[data-attr="${attr}"]`).forEach(b =>
                b.classList.remove('border-neutral-900', 'bg-neutral-900', 'text-white'));
            btn.classList.add('border-neutral-900', 'bg-neutral-900', 'text-white');
            selected[attr] = btn.dataset.value;
            refresh();
        });
    });

    // Add to cart
    addBtn?.addEventListener('click', async () => {
        if (hasVariants && !selectedVariantId) return;
        const productId = @Model.Id;
        const body = new URLSearchParams({ productId, quantity: 1 });
        if (selectedVariantId) body.append('variantId', selectedVariantId);

        const res = await fetch('/Cart/Add', { method: 'POST', body, headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
        const data = await res.json();
        if (data.success) {
            if (window.updateCartBadge) window.updateCartBadge(data.cartCount);
            const orig = addBtn.textContent;
            addBtn.textContent = 'Added to Bag ✓';
            setTimeout(() => { addBtn.textContent = orig; }, 1500);
        } else if (data.message) {
            alert(data.message);
        }
    });

    // Wishlist toggle
    document.getElementById('wishlist-btn')?.addEventListener('click', async () => {
        const productId = @Model.Id;
        const res = await fetch('/Wishlist/Toggle', { method: 'POST', body: new URLSearchParams({ productId }), headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } });
        const data = await res.json();
        if (data.success) location.reload();
    });
})();
</script>
}
